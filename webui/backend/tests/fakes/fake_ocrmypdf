#!/usr/bin/env python3
"""Stand-in for ocrmypdf used by the backend tests."""
import os
import shutil
import sys

if os.environ.get("FAKE_OCR_FAIL"):
    print("ocr exploded", file=sys.stderr)
    sys.exit(3)
src, dst = sys.argv[-2], sys.argv[-1]
shutil.copy(src, dst)
with open(dst, "ab") as f:
    f.write(b" +ocr")
print("ocr ok", file=sys.stderr)
